# --- Hindsight (long-term memory) ---
# Hindsight Cloud: get a key at https://ui.hindsight.vectorize.io
HINDSIGHT_API_KEY=
HINDSIGHT_BASE_URL=https://api.hindsight.vectorize.io
HINDSIGHT_BANK_ID=lifeline-demo

# Self-hosted alternative: run `docker run -p 8888:8888 ghcr.io/vectorize-io/hindsight:latest`
# then set HINDSIGHT_BASE_URL=http://localhost:8888 (API key optional locally).

# --- Groq LLM ---
# Get a key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- App ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO
